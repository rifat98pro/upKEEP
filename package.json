{
  "name": "upkeep",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent financial conditions for Arc.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keeper": "tsx --env-file-if-exists=.env.local scripts/keeper.ts",
    "keeper:once": "tsx --env-file-if-exists=.env.local scripts/keeper.ts --once",
    "preflight": "tsx --env-file-if-exists=.env.local scripts/preflight.ts",
    "abi": "node scripts/generate-abi.mjs",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test -vv",
    "contracts:deploy": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url $ARC_RPC_URL --broadcast --private-key $DEPLOYER_PRIVATE_KEY",
    "test:e2e": "tsx --env-file-if-exists=.env.local scripts/e2e.ts",
    "chain": "anvil --chain-id 5042 --port 8545",
    "contracts:install": "cd contracts && forge install foundry-rs/forge-std --no-git && forge install OpenZeppelin/openzeppelin-contracts --no-git",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "contracts:deploy:local": "cd contracts && forge script script/Deploy.s.sol:Deploy --rpc-url http://127.0.0.1:8545 --broadcast",
    "verify:ui": "tsx --env-file-if-exists=.env.local scripts/verify-ui.ts",
    "demo:micro": "tsx --env-file-if-exists=.env.local scripts/demo-micro.ts",
    "icons": "node scripts/generate-icons.mjs",
    "arc:test": "wsl -d Ubuntu -e bash -lc \"cd \\\"$(wslpath -a .)/contracts\\\" && ~/.local/bin/arc-forge test\"",
    "deploy:mainnet": "node scripts/deploy-mainnet.mjs",
    "schedule:register": "node scripts/register-schedule.mjs",
    "logo:transparent": "node scripts/logo-transparent.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-query": "^5.62.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "viem": "^2.21.58",
    "wagmi": "^2.14.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.49",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
