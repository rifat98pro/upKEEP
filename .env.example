# ============================================================================
# upKEEP environment configuration
#
# Copy to .env.local and fill in. NEVER commit .env or .env.local - they are
# already in .gitignore. This file contains placeholders only, no real secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# Arc Mainnet
#
# Defaults below are the official values from https://docs.arc.io/arc/references/connect-to-arc
# You only need to change these to point at a private or higher-rate-limit node.
# ----------------------------------------------------------------------------

# Read by the browser bundle.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io

# Read by server code (API routes, keeper). Falls back to the public URL.
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Arc Mainnet chain id. Do not change unless you are pointing at your own node.
NEXT_PUBLIC_ARC_CHAIN_ID=5042
ARC_CHAIN_ID=5042

NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io
NEXT_PUBLIC_ARC_WS_URL=wss://rpc.quicknode.mainnet.arc.io

# ----------------------------------------------------------------------------
# USDC
#
# On Arc, USDC is the NATIVE gas token (18 decimals) and additionally exposes an
# ERC-20 interface (6 decimals) over the same balance at the address below.
# These are compiled into the SDK and listed here for reference; there is no
# need to set them.
#
#   USDC_ERC20_ADDRESS=0x3600000000000000000000000000000000000000
#   USDC_NATIVE_DECIMALS=18
#   USDC_ERC20_DECIMALS=6
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Deployed upKEEP contracts
#
# Left empty by default. With these unset the app reads live Arc balances but
# shows an explicit "not deployed" state instead of pretending to have data.
#
# `npm run contracts:deploy` prints these lines ready to paste.
# ----------------------------------------------------------------------------

NEXT_PUBLIC_CONDITION_REGISTRY_ADDRESS=
NEXT_PUBLIC_AUTOMATION_EXECUTOR_ADDRESS=
NEXT_PUBLIC_VAULT_FACTORY_ADDRESS=

# Block the protocol was deployed at, so execution log scans start in the right
# place rather than sweeping a speculative window.
NEXT_PUBLIC_DEPLOY_BLOCK=

# ----------------------------------------------------------------------------
# Protocol fee
#
# 5 bps = 0.05%, charged only on a successful execution. The value here is used
# for UI quotes; each vault stores its own rate in an immutable at construction,
# so the contract is authoritative for what is actually charged.
# ----------------------------------------------------------------------------

UPKEEP_FEE_BPS=5
NEXT_PUBLIC_UPKEEP_FEE_BPS=5

# ----------------------------------------------------------------------------
# Keeper (the monitoring service)
# ----------------------------------------------------------------------------

# Operational key that pays gas to submit executions.
#
# This is NOT custody of user funds: vaults authorize the executor *contract*,
# not this account, and the executor can only perform the one action a user
# authorized. Still, treat it as a hot key - fund it with only what it needs.
KEEPER_PRIVATE_KEY=

# How often to sweep conditions. Keep this modest: aggressive polling is how a
# client gets rate limited off a public endpoint.
UPKEEP_POLL_INTERVAL_MS=30000

# Set to true to evaluate and log without ever sending a transaction.
KEEPER_DRY_RUN=false

# ----------------------------------------------------------------------------
# Contract deployment
#
# Used only by contracts/script/Deploy.s.sol. NEVER commit a real private key.
# ----------------------------------------------------------------------------

DEPLOYER_PRIVATE_KEY=

# Protocol admin. Defaults to the deployer address if unset.
UPKEEP_ADMIN=

# Where protocol fees are sent. Required.
UPKEEP_TREASURY=

# Keeper address to authorize on the executor at deploy time.
UPKEEP_KEEPER=

# Optional, for `forge verify-contract` if the explorer exposes a verification API.
ARC_EXPLORER_API_URL=
ARC_EXPLORER_API_KEY=

# ----------------------------------------------------------------------------
# Demo mode
#
# MUST stay false for anything resembling production. When true the UI renders
# deterministic sample data and marks every surface with a DEMO MODE banner so
# it can never be mistaken for Arc Mainnet activity.
# ----------------------------------------------------------------------------

NEXT_PUBLIC_DEMO_MODE=false

# ----------------------------------------------------------------------------
# Database (optional)
#
# upKEEP does not require one. Conditions live in the on-chain registry and
# executions are read back from chain logs, so there is no second source of
# truth to keep in sync. Set this only if you add your own indexing layer.
# ----------------------------------------------------------------------------

DATABASE_URL=
